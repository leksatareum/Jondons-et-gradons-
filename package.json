{
  "name": "jondons-et-gradons",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Moteur de règles D&D 5e (2024) pour la campagne « Les Loups Rouges » — les capacités sont dérivées à la lecture, jamais figées à la création du personnage.",
  "engines": {
    "node": "22.x"
  },
  "scripts": {
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit -p tsconfig.json --pretty false",
    "check": "npm run typecheck && npm run test",
    "dev": "vite",
    "build": "npm run typecheck && vite build",
    "preview": "vite preview"
  },
  "devDependencies": {
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vitejs/plugin-react": "^6.0.5",
    "typescript": "6.0.3",
    "vite": "^8.2.1",
    "vitest": "4.1.10"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.112.3",
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  }
}
